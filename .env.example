# Application Configurations
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database Configurations (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password
DATABASE_NAME=his_dao_care
# URL-encoded Connection String for Prisma/TypeORM
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/his_dao_care?schema=public

# Object Storage Configurations (MinIO)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET_NAME=his-dao-care-assets

# Security & CORS
CORS_ORIGIN_WHITELIST=http://localhost:5173

# Rate Limiting
PUBLIC_RATE_LIMIT_TTL=900
PUBLIC_RATE_LIMIT_MAX=100
SENSITIVE_RATE_LIMIT_TTL=60
SENSITIVE_RATE_LIMIT_MAX=5

# Authentication & JWT
JWT_SECRET=super_secret_jwt_key_should_be_changed_in_prod
JWT_EXPIRATION_TIME=1d
OTP_EXPIRATION_TIME=300
GOOGLE_AUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Third-party Integrations
VIETQR_BANK_CODE=970418
VIETQR_ACCOUNT_NUMBER=2152486504
VIETQR_ACCOUNT_NAME=TRAN HUU NAM
GOOGLE_MAILER_CLIENT_ID=your_google_mailer_client_id.apps.googleusercontent.com
GOOGLE_MAILER_CLIENT_SECRET=your_google_mailer_client_secret
GOOGLE_MAILER_REFRESH_TOKEN=your_google_mailer_refresh_token
ADMIN_EMAIL_ADDRESS=admin@example.com

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here
